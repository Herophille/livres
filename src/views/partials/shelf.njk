{% if books.length == 0 %}
  <div class="empty">
    {% if q %}
      <p>Aucun livre ne correspond à « {{ q }} ».</p>
    {% elif status and not genreId %}
      <p>Aucun livre avec le statut « {{ status | statusLabel }} ».</p>
    {% elif genreId or status %}
      <p>Aucun livre ne correspond à ces filtres.</p>
    {% elif scope == 'tous' %}
      <p>Le catalogue commun est vide.</p>
      <a class="button" href="/ajouter">Ajouter un premier livre</a>
    {% else %}
      <p>Votre bibliothèque est vide.</p>
      <a class="button" href="/ajouter">Ajouter un premier livre</a>
    {% endif %}
  </div>
{% elif view == 'liste' %}
  <ul class="booklist">
    {% for book in books %}
    <li>
      <a href="/livres/{{ book.id }}" class="booklist__row">
        <span class="booklist__cover">{% set thumb = true %}{% include "partials/cover.njk" %}</span>
        <span class="booklist__text">
          <span class="booklist__title">{{ book.title }}</span>
          <span class="booklist__author">{{ book.authors }}</span>
          {% if book.rating %}<span class="stars" role="img" aria-label="Noté {{ book.rating }} sur 5">{% for i in range(0, 5) %}<span class="{{ 'is-on' if i < book.rating }}">★</span>{% endfor %}</span>{% endif %}
        </span>
        {% if book.status %}<span class="status-dot status-dot--{{ book.status }}" title="{{ book.status | statusLabel }}"></span>{% endif %}
      </a>
    </li>
    {% endfor %}
  </ul>
{% else %}
  <ul class="grid">
    {% for book in books %}
    <li>
      <a href="/livres/{{ book.id }}" class="grid__item">
        {% set thumb = true %}{% include "partials/cover.njk" %}
        <span class="grid__title">{{ book.title }}</span>
        <span class="grid__author">{{ book.authors }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
{% endif %}
