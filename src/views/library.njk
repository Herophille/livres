{% extends "layout.njk" %}
{% block content %}
<header class="page-head">
  <h1 class="large-title">Bibliothèque</h1>
</header>

{# Affiché par app.js seulement sur téléphone, hors application installée #}
<aside id="install-hint" class="install-hint" hidden>
  <img src="/static/img/icon-180.png" alt="" width="44" height="44">
  <div class="install-hint__text">
    <p class="install-hint__title">Ajoutez Livres à votre écran d'accueil</p>
    <p data-platform="ios">Dans Safari, touchez <strong>Partager</strong> puis <strong>Sur l'écran d'accueil</strong>.</p>
    <p data-platform="android">Dans le menu <strong>⋮</strong> de Chrome, choisissez <strong>Ajouter à l'écran d'accueil</strong>.</p>
  </div>
  <button type="button" class="install-hint__close" aria-label="Masquer ce conseil">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4z"/></svg>
  </button>
</aside>

<nav class="segmented segmented--2 scope" aria-label="Livres affichés">
  <a href="/?vue={{ view }}" class="segmented__item {% if scope == 'moi' %}is-on{% endif %}" {% if scope == 'moi' %}aria-current="page"{% endif %}>Mes livres</a>
  <a href="/?portee=tous&amp;vue={{ view }}" class="segmented__item {% if scope == 'tous' %}is-on{% endif %}" {% if scope == 'tous' %}aria-current="page"{% endif %}>Tous les livres</a>
</nav>

<form class="toolbar" method="get" action="/"
      hx-get="/" hx-target="#shelf" hx-trigger="input changed delay:300ms from:input[name=q], change"
      hx-push-url="true">
  {% if scope == 'tous' %}<input type="hidden" name="portee" value="tous">{% endif %}
  <label class="search">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3a7 7 0 0 1 5.6 11.2l5.1 5.1-1.4 1.4-5.1-5.1A7 7 0 1 1 10 3zm0 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10z"/></svg>
    <span class="visually-hidden">Rechercher</span>
    <input type="search" name="q" value="{{ q or '' }}" placeholder="Titre, auteur ou ISBN" autocomplete="off" enterkeyhint="search">
  </label>
  <div class="viewswitch" role="radiogroup" aria-label="Affichage">
    <label title="Grille"><input type="radio" name="vue" value="grille" {% if view == 'grille' %}checked{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z"/></svg>
      <span class="visually-hidden">Grille</span></label>
    <label title="Liste"><input type="radio" name="vue" value="liste" {% if view == 'liste' %}checked{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v3H3zm0 6.5h18v3H3zM3 17h18v3H3z"/></svg>
      <span class="visually-hidden">Liste</span></label>
  </div>

  <div class="filters">
    <label class="filter">
      <span class="visually-hidden">Genre</span>
      <select name="genre">
        <option value="">Tous les genres</option>
        {% for g in genres %}<option value="{{ g.id }}" {% if genreId == g.id %}selected{% endif %}>{{ g.name }}</option>{% endfor %}
      </select>
    </label>
    <label class="filter">
      <span class="visually-hidden">Trier par</span>
      <select name="tri">
        {% for s in sorts %}<option value="{{ s.value }}" {% if sort == s.value %}selected{% endif %}>Tri : {{ s.label | lower }}</option>{% endfor %}
      </select>
    </label>
  </div>

  {% if scope == 'moi' %}
  <div class="chips" role="radiogroup" aria-label="Filtrer par statut">
    <label class="chip"><input type="radio" name="statut" value="" {% if not status %}checked{% endif %}>
      Tous <span class="chip__n">{{ counts.all or 0 }}</span></label>
    {% for s in statuses %}
    <label class="chip"><input type="radio" name="statut" value="{{ s.value }}" {% if status == s.value %}checked{% endif %}>
      {{ s.label }} <span class="chip__n">{{ counts[s.value] or 0 }}</span></label>
    {% endfor %}
  </div>
  {% endif %}
  <noscript><button type="submit" class="button button--quiet">Filtrer</button></noscript>
</form>

<section id="shelf" aria-live="polite">
  {% include "partials/shelf.njk" %}
</section>
{% endblock %}
