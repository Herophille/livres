{% extends "layout.njk" %}
{% block content %}
<a class="back" href="/">Bibliothèque</a>

{% if notice %}<p class="notice notice--action"><span>{{ notice }}</span> <a href="/ajouter">Ajouter un autre livre</a></p>{% endif %}

<article class="book">
  <div class="book__cover">
    {% set book = { title: work.title, authors: work.authors, cover_file: edition.cover_file if edition else null } %}
    {% set thumb = false %}
    {% include "partials/cover.njk" %}
  </div>

  <div class="book__main">
    <h1 class="book__title">{{ work.title }}</h1>
    {% if work.authors %}<p class="book__authors">{{ work.authors }}</p>{% endif %}

    {% include "partials/status.njk" %}

    <dl class="details">
      {% if work.genre_name %}<div><dt>Genre</dt><dd>{{ work.genre_name }}</dd></div>{% endif %}
      {% if work.country_code %}<div><dt>Pays de première publication</dt><dd>{{ work.country_code | countryLabel }}</dd></div>{% endif %}
      {% if work.original_language %}<div><dt>Langue originale</dt><dd>{{ work.original_language | languageLabel }}</dd></div>{% endif %}
      {% if edition %}
        {% if edition.edition_title %}<div><dt>Titre de cette édition</dt><dd>{{ edition.edition_title }}</dd></div>{% endif %}
        {% if edition.language %}<div><dt>Langue de cette édition</dt><dd>{{ edition.language | languageLabel }}</dd></div>{% endif %}
        {% if edition.format %}<div><dt>Format</dt><dd>{{ edition.format | formatLabel }}</dd></div>{% endif %}
        {% if edition.page_count %}<div><dt>Pages</dt><dd>{{ edition.page_count }}</dd></div>{% endif %}
        {% if edition.publisher %}<div><dt>Éditeur</dt><dd>{{ edition.publisher }}</dd></div>{% endif %}
        {% if edition.published_date %}<div><dt>Publication</dt><dd>{{ edition.published_date }}</dd></div>{% endif %}
        {% if edition.isbn %}<div><dt>ISBN</dt><dd class="tabular">{{ edition.isbn }}</dd></div>{% endif %}
      {% endif %}
    </dl>

    {% include "partials/review.njk" %}

    {% if friends.length %}
    <section class="friend-reviews" aria-labelledby="friends-title">
      <h2 id="friends-title" class="section-title">Chez les amis</h2>
      <ul class="friend-reviews__list">
        {% for f in friends %}
        <li class="friend-review">
          <div class="friend-review__head">
            <span class="avatar" style="--h: {{ f.username | hue }}" aria-hidden="true">{{ f.display_name | initial }}</span>
            <span class="friend-review__who">
              <a href="/amis/{{ f.username }}" class="friend-review__name">{{ f.display_name }}</a>
              <span class="friend-review__meta">
                {% if f.status %}<span class="status-dot status-dot--{{ f.status }}" aria-hidden="true"></span>{{ f.status | statusLabel }}{% if f.status == 'lu' and f.finished_on %} le {{ f.finished_on | dateFr }}{% endif %}{% else %}N'a pas ce livre dans sa bibliothèque{% endif %}
              </span>
            </span>
          </div>
          {% if f.rating or f.recommends !== null %}
          <p class="friend-review__verdict">
            {% if f.rating %}<span class="stars stars--large" role="img" aria-label="Noté {{ f.rating }} sur 5">{% for i in range(0, 5) %}<span class="{{ 'is-on' if i < f.rating }}">★</span>{% endfor %}</span>{% endif %}
            {% if f.recommends === 1 %}<span class="badge">Recommande</span>{% elif f.recommends === 0 %}<span class="badge badge--muted">Ne recommande pas</span>{% endif %}
          </p>
          {% endif %}
          {% if f.body %}<p class="friend-review__body">{{ f.body }}</p>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if editions.length > 1 %}
    <section class="editions" aria-labelledby="editions-title">
      <h2 id="editions-title" class="section-title">{{ editions.length }} éditions</h2>
      <ul class="booklist">
        {% for e in editions %}
        <li>
          <div class="booklist__row">
            <span class="booklist__cover">{% set book = { title: e.edition_title or work.title, cover_file: e.cover_file } %}{% set thumb = true %}{% include "partials/cover.njk" %}</span>
            <span class="booklist__text">
              <span class="booklist__title">{{ e.edition_title or work.title }}</span>
              <span class="booklist__author">{{ [e.language | languageLabel, e.format | formatLabel, e.publisher, e.published_date | truncate(4, true, '')] | select | join(' · ') }}</span>
            </span>
            {% if e.id == edition.id %}
              <span class="badge">{{ 'Mon édition' if reading else 'Affichée' }}</span>
            {% elif reading %}
              <form method="post" action="/livres/{{ work.id }}/edition">
                <input type="hidden" name="edition_id" value="{{ e.id }}">
                <button type="submit" class="button button--quiet button--small">C'est la mienne</button>
              </form>
            {% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <div class="actions">
      <a class="button button--quiet" href="/livres/{{ work.id }}/modifier">Modifier la fiche</a>
      {% if currentUser.role == 'admin' %}
      <form method="post" action="/livres/{{ work.id }}/supprimer"
            data-confirm="Supprimer ce livre pour tous les utilisateurs ? Cette action est définitive.">
        <button type="submit" class="button button--danger">Supprimer le livre</button>
      </form>
      {% endif %}
    </div>
  </div>
</article>
{% endblock %}
