<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ title }} · Livres</title>
  <meta name="theme-color" content="#f2f2f5" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Livres">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="format-detection" content="telephone=no">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/static/img/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/static/img/icon-180.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/vendor/htmx/htmx.min.js" defer></script>
  <script src="/static/js/app.js" defer></script>
</head>
<body>
  {% if currentUser %}
  <nav class="tabbar" aria-label="Navigation principale">
    <a href="/" class="tab {% if path == '/' or path.startsWith('/livres') %}is-active{% endif %}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h4v16H4zM10 4h4v16h-4zM16.5 5.2l3.8-1 3.7 15.5-3.9.9z"/></svg>
      <span>Bibliothèque</span>
    </a>
    <a href="/ajouter" class="tab {% if path.startsWith('/ajouter') %}is-active{% endif %}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18zm-1 5v3H8v2h3v3h2v-3h3v-2h-3V8z"/></svg>
      <span>Ajouter</span>
    </a>
    <a href="/amis" class="tab {% if path.startsWith('/amis') %}is-active{% endif %}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 1.8c-3.9 0-7 2-7 4.6V20h14v-2.1c0-2.6-3.1-4.6-7-4.6zm7.5-1.8a3.3 3.3 0 1 0 0-6.6 3.3 3.3 0 0 0 0 6.6zm.8 1.9c1.7.8 2.7 2.3 2.7 4.5V20h3v-1.9c0-2.4-2.4-4.3-5.7-4.6z"/></svg>
      <span>Amis</span>
    </a>
    <a href="/profil" class="tab {% if path.startsWith('/profil') or path.startsWith('/admin') %}is-active{% endif %}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zm0 2c-4.4 0-8 2.2-8 5v2h16v-2c0-2.8-3.6-5-8-5z"/></svg>
      <span>Profil</span>
    </a>
  </nav>
  {% endif %}

  <div class="nav-progress" aria-hidden="true"></div>
  <main class="page">
    {% block content %}{% endblock %}
  </main>
  {% block scripts %}{% endblock %}
</body>
</html>
