# Copiez ce fichier en .env et remplissez-le (ou saisissez ces variables dans Portainer).

# Port sur lequel l'app sera joignable sur le serveur
HOST_PORT=8090

# Premier compte admin, créé uniquement au tout premier démarrage
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi

# Secret de signature des cookies : générez-le avec `openssl rand -hex 32`
COOKIE_SECRET=

# Où stocker la base, les couvertures et les sauvegardes sur le serveur
DATA_PATH=./data
BACKUP_PATH=./backups

# Sauvegarde quotidienne de la base : heure (0-23) et nombre de jours conservés
BACKUP_HOUR=3
BACKUP_KEEP=14

TZ=Europe/Paris

# Facultatif : clé API Google Books (quota plus élevé)
GOOGLE_BOOKS_API_KEY=
